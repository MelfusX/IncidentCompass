<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Keep Microsoft.OpenApi on 2.x: the 2.x floor avoids the deprecated transitive 2.0.0,
         while 3.x is not compatible with Microsoft.AspNetCore.OpenApi 10.x source generation. -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Endpoints\Otlp\Protos\opentelemetry\proto\**\*.proto" ProtoRoot="Endpoints\Otlp\Protos" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IncidentCompass.Application\IncidentCompass.Application.csproj" />
    <ProjectReference Include="..\IncidentCompass.Infrastructure\IncidentCompass.Infrastructure.csproj" />
  </ItemGroup>

</Project>
