<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IncidentCompass.Application\IncidentCompass.Application.csproj" />
    <ProjectReference Include="..\IncidentCompass.Domain\IncidentCompass.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Pgvector" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\infra\postgres\init\*.sql" Link="PostgresSchemaScripts\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- CA1822 fires on the OpenAI-compatible provider collaborators (options resolver, request
         factory, response mapper, error mapper, retry policy under Embeddings/OpenAi and
         ModelGateway/OpenAi) whose methods do not currently touch instance state. Those types are
         deliberately instantiable, single-purpose collaborators composed into the executor via
         constructor injection (see docs/model-gateway.md) rather than static utility classes, so
         each concern stays independently substitutable. Collapsing OpenAiModelJson,
         OpenAiModelRetryPolicy and OpenAiModelOptionsResolver into their callers is deferred to
         backlog item IC-BL-075, which owns that provider-gateway reshaping. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

</Project>
