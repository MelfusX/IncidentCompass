<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Integration tests suppress xUnit1051 because host/client APIs expose many optional tokens;
         cancellation-sensitive paths pass TestContext.Current.CancellationToken explicitly. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Baselines\openapi-v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IncidentCompass.Application\IncidentCompass.Application.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Api\IncidentCompass.Api.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Infrastructure\IncidentCompass.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Worker\IncidentCompass.Worker.csproj" />
  </ItemGroup>

</Project>
